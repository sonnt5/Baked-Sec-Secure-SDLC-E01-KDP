# Coding War Backend — Environment Variables
# Copy this file to .env and update values

# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
LOG_LEVEL=DEBUG

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/coding_war

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Authentication
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@codingwar.dev

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=coding-war-testcases
S3_PRESIGNED_URL_EXPIRY=300

# Judge
JUDGE_CONCURRENCY=3
JUDGE_TIMEOUT=30000
# JUDGE_HMAC_SECRET=  # Required for distributed judge (ADR-002)
